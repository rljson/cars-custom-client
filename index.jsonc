{
  "name": "@rljson/cars-custom-client",
  "summary": "Client website of the custom side of the cars example app, where released catalogs are edited further for customers: a static page that shows its own hello line and the lines of /api/hello; served by nginx as the container app ca-cars-custom-client-<stage>, which forwards /api to the master of its side.",
  "domain": ["static page in the browser; later syncs with the master of its side and ships as an Electron app", "container cars-custom-client, nginx, uid 1000, port 8080, GET /health"],
  "interfaces": {
    "uses": {
      "cars-custom-master": "GET /api/hello over HTTP at MASTER_URL; the page asks api/hello relative to its own path",
    },
    "usedBy": {},
  },
}
